# 通用约定（适用于全部 Provider）
# - 本文件仅为配置模板；实际值写入 .env，不得提交。
# - 各 adapter 均以单 worker 运行，健康检查不登录 SDK、不访问上游。
# - 不设置内部 API Key，adapter 不发布宿主机端口。
# - 当前没有三家共用的环境变量；以下均为 Provider 专属配置。

# AkShare 专属
# 无需上游凭据；同步 SDK 调用的有界并发上限。
TAPEHUB_AKSHARE_MAX_INFLIGHT=4

# Baostock 专属
# 无需上游凭据；有界并发上限，实际会话操作仍由全局锁串行化。
TAPEHUB_BAOSTOCK_MAX_INFLIGHT=4

# TqSdk 专属
# 快期账户凭据只注入 tapehub-tqsdk-adapter；TapeHub 不读取、保存或转发。
TAPEHUB_TQSDK_AUTH_USER=
TAPEHUB_TQSDK_AUTH_PASSWORD=

# 连接模式：shared 为共享长连接；per_request 为每请求独立实例的回滚模式。
TAPEHUB_TQSDK_CONN_MODE=shared
# 在飞 K 线请求上限，超出返回 CONCURRENCY_LIMIT。
TAPEHUB_TQSDK_MAX_INFLIGHT_FETCH=16
# 快照冷订阅首包等待秒数，超时返回 QUOTE_NOT_READY。
TAPEHUB_TQSDK_FIRST_SNAPSHOT_TIMEOUT=5
# 休眠订阅达到该数量时触发 Runtime 代际回收。
TAPEHUB_TQSDK_SUBSCRIPTION_LIMIT=64
# 单次 Runtime 构造等待秒数；超时后后台仍可继续重试。
TAPEHUB_TQSDK_CONSTRUCT_TIMEOUT=30
